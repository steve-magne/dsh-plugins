{
	"name": "@dsh-plugins/create-pr",
	"version": "0.1.1",
	"description": "DSH web plugin: one-click GitHub pull request from the composer tool row — deterministic git/gh plumbing, one LLM call for the conventional-commit message, and a CI watchdog that wakes the owning session to fix failures",
	"keywords": [
		"dsh-plugin",
		"deepseek-harness",
		"deepseek",
		"cordis",
		"github",
		"pull-request",
		"ci"
	],
	"homepage": "https://github.com/steve-magne/dsh-plugins/tree/main/packages/create-pr#readme",
	"bugs": {
		"url": "https://github.com/steve-magne/dsh-plugins/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/steve-magne/dsh-plugins.git",
		"directory": "packages/create-pr"
	},
	"license": "MIT",
	"author": {
		"name": "Steve Magne",
		"url": "https://github.com/steve-magne"
	},
	"type": "module",
	"main": "./lib/index.js",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"README.md"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"dsh": {
		"client": {
			"platform": "web",
			"inject": []
		}
	}
}
