		"github",
		"inbox",
		"triage",
		"agents"
	],
	"homepage": "https://github.com/steve-magne/dsh-plugins/tree/main/packages/mission-control#readme",
	"bugs": {
		"url": "https://github.com/steve-magne/dsh-plugins/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/steve-magne/dsh-plugins.git",
		"directory": "packages/mission-control"
	},
	"license": "MIT",
	"author": {
		"name": "Steve Magne",
		"url": "https://github.com/steve-magne"
	},
	"type": "module",
	"main": "./lib/index.js",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
